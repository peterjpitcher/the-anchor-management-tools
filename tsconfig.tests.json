{
  // Type-checks the tests/ tree, which tsconfig.json excludes (and `npm run lint` never reads).
  // Vitest strips types, so without this a stale fixture or a mock of a deleted export still
  // passes `npm test`. Run it with `npm run typecheck:tests`; CI runs it beside the main check.
  // src/**/*.d.ts brings in the ambient module declarations the app relies on.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": ["next-env.d.ts", "vitest.setup.ts", "src/**/*.d.ts", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": []
}
